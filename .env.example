# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ACLED account (register free at https://acleddata.com/register/)
# Note: the free tier embargoes the most recent 12 months of events.
ACLED_EMAIL=you@example.edu
ACLED_PASSWORD=your_password

# Optional — UCDP GED, used as a fallback ground-truth source
# Register at https://ucdp.uu.se/apidocs/
# UCDP_API_TOKEN=your_token
